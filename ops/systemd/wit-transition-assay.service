[Unit]
Description=WIT transition assay A2A provider
After=network-online.target witness-journal-rdf-projection-service.service
Wants=network-online.target witness-journal-rdf-projection-service.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/wit-transition-assay
Environment=HOST=127.0.0.1
Environment=PORT=19827
Environment=BASE_URL=http://127.0.0.1:19827
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/wit-transition-assay/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/wit-transition-assay/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=wit-transition-assay-ed25519
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
