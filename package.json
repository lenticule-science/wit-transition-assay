    "admission": "one canonical typed pair of immutable RMN effect cells and one ni-identified evidence object",
    "refusal": "zero, multiple, downward, ungrounded, identity-drifting, self-attested, executed, priced, or fallback transition",
    "operation-catalog": {
      "assay-wit-transition": {
        "contract": "ni:///sha-256;7LE0QclMlxeoBXyyJu9ghANQVmxr1nd-ydJq8tb6abc",
        "protocol": "A2A 1.0",
        "legacyCompatibility": false
      }
    }
  }
